# Supabase Postgres connection string (Project Settings > Database).
# Use the transaction pooler (port 6543) for the app; use the direct/session
# connection (port 5432) when running `pnpm db:migrate`.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Cloudflare R2 (S3-compatible). R2_PUBLIC_URL is the public bucket / custom domain.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://cdn.example.com

# Supabase Auth (Project Settings > API). The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated emails allowed into /admin (must be confirmed Supabase accounts).
ADMIN_EMAILS=owner@example.com

# Optional: public site origin used in password-reset links (defaults to the request host).
NEXT_PUBLIC_SITE_URL=

# Phone + OTP login over WhatsApp (worker/whatsapp). SESSION_SECRET must be 16+ random chars.
SESSION_SECRET=
OTP_PROVIDER=whatsapp
WHATSAPP_WORKER_URL=https://wa-worker.example.com
WHATSAPP_WORKER_TOKEN=

# Click-to-chat login: the customer messages this number first (international digits, no +).
WHATSAPP_BOT_NUMBER=967700000000
# Countries whose numbers may log in (worker side): Yemen 967, Saudi Arabia 966.
ALLOWED_COUNTRY_CODES=967,966
